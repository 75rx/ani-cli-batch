# This script updates the ani-cli-batch script

rootfolder="~/.ani-cli-batch"
setupfolder=$rootfolder"/setup"
targets="ani-cli-batch ani-cli-batch-update rofi"

echo "Creating config directory"
mkdir -p $setupfolder

cd $setupfolder

echo "Dowloading files"
for target in $targets; do
	wget https://raw.githubusercontent.com/75rx/ani-cli-batch/$target -q
echo "Done!"

echo "Installing"
chmod +x $setupfolder/*

echo "Please enter the sudo password to add the program to your PATH"
echo ""

mkdir $rootfolder/falsebin
mv $setupfolder/rofi $rootfolder/falsebin/rofi && sudo mv -t /usr/local/bin/ $setupfolder/* && echo "sudo access granted. Update successful"
